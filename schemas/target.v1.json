{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wakeio.target/v1",
  "title": "Wakeio M1 target data (no execution authority)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "source", "build", "pack", "entry", "dependencies", "seed", "scope", "budget"],
  "properties": {
    "version": { "const": 1 },
    "project": { "$ref": "#/$defs/id" },
    "source": { "anyOf": [{ "const": "." }, { "$ref": "#/$defs/file" }] },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "file", "service"],
      "properties": {
        "kind": { "const": "compose" },
        "file": { "$ref": "#/$defs/file" },
        "service": { "$ref": "#/$defs/service" }
      }
    },
    "pack": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false, "required": ["port", "health", "startupTimeoutSec"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "health": { "$ref": "#/$defs/health" },
        "startupTimeoutSec": { "type": "integer", "minimum": 1, "maximum": 900 }
      }
    },
    "dependencies": {
      "type": "array", "maxItems": 16, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["service", "observer"],
        "properties": { "service": { "$ref": "#/$defs/service" }, "observer": { "const": "pg-log" } }
      }
    },
    "seed": {
      "type": "object", "additionalProperties": false, "required": ["sql", "snapshot"],
      "properties": {
        "sql": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/file" } },
        "snapshot": { "const": "per-request" }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
          "items": { "$ref": "#/$defs/scope" }
        },
        "exclude": {
          "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "$ref": "#/$defs/scope" }
        }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["maxRequests", "maxMinutes", "ratePerSecond"],
      "properties": {
        "maxRequests": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "maxMinutes": { "type": "integer", "minimum": 1, "maximum": 15 },
        "ratePerSecond": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])" },
    "service": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*(?![\\s\\S])" },
    "file": {
      "type": "string", "maxLength": 512,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[\\w.][\\w.-]*(?:/[\\w.][\\w.-]*)*(?![\\s\\S])"
    },
    "health": {
      "type": "string", "maxLength": 512,
      "pattern": "^/(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[\\w~./-]*(?![\\s\\S])"
    },
    "scope": {
      "type": "string", "maxLength": 512,
      "pattern": "^/(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[\\w~./*{}:-]*(?![\\s\\S])"
    }
  }
}
