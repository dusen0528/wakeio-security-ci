{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wakeio.framework-pack/v1",
  "title": "Bounded M1 FrameworkPack data, not an executable rule or execution permission",
  "type": "object", "additionalProperties": false,
  "required": ["id", "version", "languages", "detect", "runtime", "surfaces", "sources", "sinks", "sanitizers"],
  "properties": {
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])" },
    "version": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "languages": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": { "enum": ["java", "kotlin"] }
    },
    "detect": {
      "type": "object", "additionalProperties": false, "required": ["anyFile", "contains"],
      "properties": {
        "anyFile": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": { "$ref": "#/$defs/file" } },
        "contains": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["profile", "env", "defaultPort", "health"],
      "properties": {
        "profile": { "const": "jvm" },
        "defaultPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "health": { "$ref": "#/$defs/path" },
        "env": { "type": "object", "maxProperties": 32,
          "propertyNames": { "type": "string", "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])" },
          "additionalProperties": { "type": "string", "maxLength": 256,
            "pattern": "^[A-Za-z0-9_,.-]*(?![\\s\\S])" } }
      }
    },
    "surfaces": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["provider"],
          "properties": { "provider": { "const": "spring-actuator" } } },
        { "type": "object", "additionalProperties": false, "required": ["provider", "paths"],
          "properties": { "provider": { "const": "openapi" },
            "paths": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
              "items": { "$ref": "#/$defs/path" } } } },
        { "type": "object", "additionalProperties": false, "required": ["provider", "annotations"],
          "properties": { "provider": { "const": "source-routes" },
            "annotations": { "$ref": "#/$defs/annotations" } } }
      ]
    } },
    "sources": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["annotation"],
          "properties": { "annotation": { "$ref": "#/$defs/annotations" } } },
        { "type": "object", "additionalProperties": false, "required": ["call"],
          "properties": { "call": { "$ref": "#/$defs/calls" } } }
      ]
    } },
    "sinks": { "type": "object", "additionalProperties": false, "required": ["sql"], "properties": {
      "sql": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {
        "type": "object", "additionalProperties": false, "required": ["call", "arg"], "properties": {
          "call": { "$ref": "#/$defs/calls" }, "arg": { "type": "integer", "minimum": 0, "maximum": 7 }
        }
      } }
    } },
    "sanitizers": { "type": "object", "additionalProperties": false, "required": ["sql"], "properties": {
      "sql": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": {
        "type": "object", "additionalProperties": false, "required": ["call", "when"], "properties": {
          "call": { "$ref": "#/$defs/calls" },
          "when": { "type": "object", "additionalProperties": false, "required": ["argCount", "placeholders"],
            "properties": { "argCount": { "enum": [">=2", ">=3", ">=4", ">=5", ">=6", ">=7", ">=8"] },
              "placeholders": { "const": true } } }
        }
      } }
    } }
  },
  "$defs": {
    "annotations": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "type": "string", "maxLength": 128,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*(?![\\s\\S])" } },
    "calls": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "type": "string", "maxLength": 128,
        "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*\\.)+(?:[A-Za-z_][A-Za-z0-9_]*\\*?|\\*)(?![\\s\\S])" } },
    "file": { "type": "string", "maxLength": 512,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[\\w.][\\w.-]*(?:/[\\w.][\\w.-]*)*(?![\\s\\S])" },
    "path": { "type": "string", "maxLength": 512,
      "pattern": "^/(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[\\w~./-]*(?![\\s\\S])" }
  }
}
