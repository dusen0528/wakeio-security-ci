    {"id": "V3", "variant": "vulnerable", "route": "GET /api/items/search", "location": "query:name",
     "payload": "quote", "expected": {
       "confirmed": 1, "reason": "quote_imbalance", "sqlState": "42601", "httpStatus": 500}},
    {"id": "F1", "variant": "fixed", "route": "GET /api/items/search", "location": "query:name",
