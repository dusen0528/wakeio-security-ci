    {"id": "F2", "variant": "fixed", "route": "POST /api/items/search", "location": "json:/name",
     "payloads": ["syntax", "quote"], "expectedEach": {"confirmed": 0, "strong": 0, "unknown": false}},
    {"id": "N4.safe", "designCase": "N4", "variant": "both", "route": "GET /api/items/safe-search",
