  "verifyExit": {"vulnerable": 1, "fixed": 0, "safeOnly": 0, "failureOnly": 2, "findingAndFailure": 1},
  "proof": {
    "syntax_promotion": "marker-derived tokens outside literals with corresponding AST syntax absent in control",
