{
  "name": "wakeio-security-ci",
  "version": "0.5.0",
  "description": "Bounded local source and URL security checks for CI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dusen0528/wakeio-security-ci.git"
  },
  "homepage": "https://github.com/dusen0528/wakeio-security-ci#readme",
  "bugs": {
    "url": "https://github.com/dusen0528/wakeio-security-ci/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "wakeio-security-ci": "./build/src/cli.js"
  },
  "types": "./build/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "default": "./build/src/index.js"
    },
    "./contracts": {
      "types": "./build/src/contracts.d.ts",
      "default": "./build/src/contracts.js"
    },
    "./agent-dast": {
      "types": "./build/src/agent-dast/index.d.ts",
      "default": "./build/src/agent-dast/index.js"
    },
    "./schemas/worker-result.v1.json": "./schemas/worker-result.v1.json"
  },
  "files": [
    "build/src",
    "build/schemas/target.v1.json",
    "schemas",
    "workers/api-state",
    "workers/api-write-state",
    "workers/runtime-controller",
    "workers/runtime-build/build.py",
    "workers/runtime-build/input_resources.py",
    "workers/runtime-build/process.py",
    "workers/runtime-build/launch.py",
    "workers/runtime-build/input.py",
    "workers/runtime-build/input_archive.py",
    "workers/runtime-build/profiles.json",
    "workers/schemathesis/worker.py",
    "workers/schemathesis/openapi.json",
    "workers/schemathesis/requirements.txt",
    "workers/schemathesis/requirements.lock.txt",
    "README.md",
    "README.ko.md",
    "README.ja.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "benchmarks/README.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "examples",
    "scripts/install-tools.mjs",
    "tests/native/runtime_provision_install_mount_test.py",
    "tests/native/runtime_provision_install_apt_test.py",
    "tests/native/fixtures/seal002-original/install_sandbox.py",
    "tests/native/fixtures/seal002-original/install_config.py"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-action-bundle.mjs",
    "test": "npm run build && node --experimental-test-module-mocks --test build/tests/*.test.js",
    "test:dast": "npm run build && node examples/dast-owned-corpus.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:perf": "npm run build && node scripts/benchmark-perf.mjs",
    "benchmark:kpi": "npm run build && node scripts/kpi.mjs",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "test:schemathesis": "node scripts/test-schemathesis.mjs",
    "test:nuclei": "npm run build && WAKEIO_REQUIRE_NUCLEI=1 node --test build/tests/nuclei.test.js",
    "test:repair:docker": "npm run build && node scripts/verify-repair-docker.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "parse5": "7.3.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "esbuild": "0.28.2"
  }
}
