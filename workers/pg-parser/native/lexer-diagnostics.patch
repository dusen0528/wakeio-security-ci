diff --git a/core/pg_query.h b/core/pg_query.h
--- a/core/pg_query.h
+++ b/core/pg_query.h
@@ -115,6 +115,31 @@
 #ifdef __cplusplus
 extern "C" {
 #endif
+
+/* Custom diagnostic ABI: no source text, strings, pointers or token/AST data. */
+typedef struct {
+  uint32_t abiRevision;
+  uint32_t encoding;
+  uint32_t standardConformingStrings;
+  uint32_t backslashQuote;
+} WakeioPg18Settings;
+
+typedef struct {
+  uint32_t abiRevision;
+  uint32_t status; /* 0 ok, 1 EOF, 2 syntax, 3 unsupported, 4 invalid. */
+  uint32_t code; /* 0 none; EOF 1..10 in the locked ABI order. */
+  uint32_t presenceBits; /* 1 construct, 2 error byte + PG char, 4 end. */
+  uint32_t constructStartByte;
+  uint32_t errorByte;
+  uint32_t endByte;
+  uint32_t pgCharPosition1Based;
+  uint32_t encoding;
+  uint32_t standardConformingStrings;
+  uint32_t backslashQuote;
+} WakeioPg18Diagnostic;
+
+WakeioPg18Diagnostic *wakeio_pg18_lexer_diagnose(const char *sql, uint32_t length,
+                                              const WakeioPg18Settings *settings);
 
 PgQueryNormalizeResult pg_query_normalize(const char* input);
 PgQueryNormalizeResult pg_query_normalize_utility(const char* input);
diff --git a/core/src/pg_query_scan.c b/core/src/pg_query_scan.c
--- a/core/src/pg_query_scan.c
+++ b/core/src/pg_query_scan.c
@@ -172,3 +172,119 @@
   free(result.pbuf.data);
   free(result.stderr_buffer);
 }
+
+/* Deliberately separate from pg_query_scan: no partial tokens or error strings. */
+#include "mb/pg_wchar.h"
+#include "parser/parser.h"
+
+_Static_assert(sizeof(WakeioPg18Settings) == 16, "settings ABI");
+_Static_assert(sizeof(WakeioPg18Diagnostic) == 44, "diagnostic ABI");
+
+typedef struct {
+  WakeioPg18Diagnostic *result;
+  WakeioPg18LexerState diagnostic;
+  core_yy_extra_type extra;
+  core_yyscan_t scanner;
+  MemoryContext context;
+  char *input;
+  uint32_t length;
+} WakeioPg18Job;
+
+static void wakeio_pg18_scan(WakeioPg18Job *job)
+{
+  core_YYSTYPE value;
+  YYLTYPE location;
+  job->context = pg_query_enter_memory_context();
+  if (GetDatabaseEncoding() != PG_UTF8) return;
+  job->scanner = scanner_init(job->input, &job->extra, &ScanKeywords, ScanKeywordTokens);
+  job->extra.wakeio_diagnostic = &job->diagnostic;
+  /* Apply the sole supported tuple to this instance, never to global GUCs. */
+  job->extra.standard_conforming_strings = true;
+  job->extra.backslash_quote = BACKSLASH_QUOTE_SAFE_ENCODING;
+  job->extra.escape_string_warning = false;
+  job->result->encoding = 1;
+  job->result->standardConformingStrings = 1;
+  job->result->backslashQuote = 1;
+  job->result->presenceBits = 4;
+  job->result->endByte = job->length;
+  while (core_yylex(&value, &location, job->scanner) != 0) {}
+  scanner_finish(job->scanner);
+  job->result->status = 0;
+}
+
+static void wakeio_pg18_capture(WakeioPg18Job *job)
+{
+  WakeioPg18Diagnostic *r = job->result;
+  ErrorData *error;
+  int cursor, sqlstate;
+  uint32_t offset = 0, character = 1;
+  MemoryContextSwitchTo(job->context ? job->context : TopMemoryContext);
+  error = CopyErrorData();
+  cursor = error->cursorpos; /* Original PG 1-based chars; zero remains absent. */
+  sqlstate = error->sqlerrcode;
+  FreeErrorData(error); /* No message, context, filename or stack reaches the POD. */
+  FlushErrorState();
+  r->status = sqlstate == ERRCODE_SYNTAX_ERROR ? 2 : 3;
+  if (cursor > 0) {
+    while (offset < job->length && character < (uint32_t) cursor) {
+      offset += pg_encoding_mblen(PG_UTF8, job->input + offset);
+      character++;
+    }
+    if (character != (uint32_t) cursor) { r->status = 3; return; }
+    r->errorByte = offset;
+    r->pgCharPosition1Based = (uint32_t) cursor;
+    r->presenceBits |= 2;
+  }
+  if (r->status != 2 || job->diagnostic.code == 0) return;
+  if (job->diagnostic.code > 10 || !(r->presenceBits & 2) ||
+      job->diagnostic.errorByte < 0 || (uint32_t) job->diagnostic.errorByte != offset ||
+      job->diagnostic.constructStartByte < 0 ||
+      (uint32_t) job->diagnostic.constructStartByte > offset ||
+      !pg_verify_mbstr(PG_UTF8, job->input, job->diagnostic.constructStartByte, true)) {
+    r->status = 3;
+    return;
+  }
+  r->constructStartByte = (uint32_t) job->diagnostic.constructStartByte;
+  r->presenceBits |= 1;
+  r->code = job->diagnostic.code;
+  r->status = 1;
+}
+
+WakeioPg18Diagnostic *wakeio_pg18_lexer_diagnose(const char *sql, uint32_t length,
+                                              const WakeioPg18Settings *settings)
+{
+  WakeioPg18Diagnostic *result = calloc(1, sizeof(*result));
+  WakeioPg18Job *job;
+  if (!result) return NULL; /* Caller closes allocation failure as unknown/error. */
+  result->abiRevision = 1;
+  result->status = 4;
+  if (!sql || length > 32768 || memchr(sql, 0, length) ||
+      !pg_verify_mbstr(PG_UTF8, sql, length, true)) return result;
+  result->status = 3;
+  if (!settings || settings->abiRevision != 1 || settings->encoding != 1 ||
+      settings->standardConformingStrings != 1 || settings->backslashQuote != 1) return result;
+  job = calloc(1, sizeof(*job));
+  if (!job) return result;
+  job->input = malloc((size_t) length + 1);
+  if (!job->input) { free(job); return result; }
+  memcpy(job->input, sql, length);
+  job->input[length] = 0;
+  job->length = length;
+  job->result = result;
+  job->diagnostic.constructStartByte = -1;
+  job->diagnostic.errorByte = -1;
+  /* The pointer itself is never reassigned after setjmp; mutable state is heap-owned. */
+  PG_TRY();
+  {
+    wakeio_pg18_scan(job);
+  }
+  PG_CATCH();
+  {
+    wakeio_pg18_capture(job);
+  }
+  PG_END_TRY();
+  if (job->context) pg_query_exit_memory_context(job->context);
+  free(job->input);
+  free(job);
+  return result;
+}
