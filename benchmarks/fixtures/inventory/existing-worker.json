{
  "openapi": "3.0.3",
  "info": {
    "title": "Synthetic staging fixture",
    "version": "1"
  },
  "paths": {
    "/items": {
      "get": {
        "operationId": "readItems",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "synthetic-secret-canary"
              ]
            }
          },
          {
            "name": "quantity",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "count"
                  ],
                  "properties": {
                    "count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin": {
      "post": {
        "operationId": "writeAdmin",
        "responses": {
          "200": {
            "description": "Excluded mutation"
          }
        }
      }
    }
  }
}
