{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "wakeio.surface-inventory/v1"
    },
    "origin": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?://[^/?#@\\s]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openapi_get": {
          "enum": [
            "observed",
            "none_detected",
            "partial"
          ]
        },
        "source_routes": {
          "const": "unverified"
        }
      },
      "required": [
        "openapi_get",
        "source_routes"
      ]
    },
    "surfaces": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "method": {
            "const": "GET"
          },
          "pathTemplate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^/[^\\u0000-\\u0020\\u007f?#\\\\]*$"
          }
        },
        "required": [
          "method",
          "pathTemplate"
        ]
      }
    },
    "unverified": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1001,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "area": {
            "enum": [
              "source_routes",
              "openapi_path_item"
            ]
          },
          "pathTemplate": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^/[^\\u0000-\\u0020\\u007f?#\\\\]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "enum": [
              "deferred_to_p1b",
              "external_ref_blocked",
              "unresolved_path_item",
              "cyclic_path_item_ref",
              "unsupported_path_item"
            ]
          }
        },
        "required": [
          "area",
          "pathTemplate",
          "reason"
        ]
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "declaredGetOperations": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "enumeratedGetOperations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "unresolvedPathItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "declaredGetOperations",
        "enumeratedGetOperations",
        "unresolvedPathItems"
      ]
    }
  },
  "required": [
    "schema",
    "origin",
    "scope",
    "surfaces",
    "unverified",
    "counts"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeio:surface-inventory/v1",
  "$comment": "P1a OpenAPI GET declaration inventory only. Runtime rules enforce counts, unique paths and gap references. See surface-inventory-p1a.md. No source routes, framework, auth or execution claims.",
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "openapi_get": {
                "const": "partial"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "counts": {
            "properties": {
              "declaredGetOperations": {
                "type": "null"
              },
              "unresolvedPathItems": {
                "minimum": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "counts": {
            "properties": {
              "declaredGetOperations": {
                "type": "integer"
              },
              "unresolvedPathItems": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "openapi_get": {
                "const": "none_detected"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "surfaces": {
            "maxItems": 0
          },
          "counts": {
            "properties": {
              "declaredGetOperations": {
                "const": 0
              },
              "enumeratedGetOperations": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "openapi_get": {
                "const": "observed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "surfaces": {
            "minItems": 1
          },
          "counts": {
            "properties": {
              "enumeratedGetOperations": {
                "minimum": 1
              }
            }
          }
        }
      }
    }
  ]
}
