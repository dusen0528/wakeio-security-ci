{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "operations",
    "seed",
    "maxRequests"
  ],
  "properties": {
    "schema": {
      "const": "wakeio.plan-preset/v1"
    },
    "id": {
      "const": "openapi-get-contract"
    },
    "operations": {
      "oneOf": [
        {
          "const": "all"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "pathTemplate"
            ],
            "properties": {
              "method": {
                "const": "GET"
              },
              "pathTemplate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^/"
              }
            }
          }
        }
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "maxRequests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    }
  }
}
